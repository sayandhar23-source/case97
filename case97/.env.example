# --- Core ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_SECRET=generate-a-long-random-string   # openssl rand -hex 32

# --- MongoDB Atlas (free M0) ---
DATABASE_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/case97?retryWrites=true&w=majority

# --- Cloudinary (only for private Premium AUDIO files; images are pasted links and need no keys) ---
# Dashboard > Settings > API Keys. Optional until you add narration.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=case97

# --- Cloudflare R2 (alternative to Cloudinary, leave empty if you use Cloudinary) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_AUDIO_BUCKET=case97-audio          # keep PRIVATE

# --- Brevo (SMTP) ---
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
EMAIL_FROM_ADDRESS=hello@yourdomain.com
EMAIL_FROM_NAME=Case97

# --- Payments (fill in Phase 5) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# --- MongoDB DNS fix (only if you get "querySrv ECONNREFUSED") ---
DNS_SERVERS=1.1.1.1,8.8.8.8

# --- Google Maps (optional: without it a basic map embed is used) ---
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
